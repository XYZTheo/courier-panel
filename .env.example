# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_token_here

# Password required to operate the bot (admin gate). Set to enable.
ADMIN_PASSWORD=

# Chat ID allowed to operate the bot (admin). Find yours via @userinfobot
# Optional - if set, adds an extra restriction on top of the password.
ADMIN_CHAT_ID=

# Server
PORT=3000
